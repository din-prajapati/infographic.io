# ============================================
# DEVELOPMENT / TEST ENVIRONMENT
# ============================================
# Copy to .env.development or .env and fill in values.
# Use Razorpay TEST Mode keys and TEST plan IDs only.
# NEVER use live keys or live plan IDs in development.
#
# Usage: cp .env.development.example .env
# Or:    cp .env.development.example .env.development
# ============================================

# ============================================
# DATABASE CONFIGURATION
# ============================================
DATABASE_URL=postgresql://user:password@localhost:5432/infographic_db
PGDATABASE=infographic_db
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=password

# ============================================
# SERVER CONFIGURATION
# ============================================
PORT=5000
API_PORT=3001
NODE_ENV=development
BASE_URL=http://localhost:5000
CLIENT_URL=http://localhost:5173

# ============================================
# AUTHENTICATION & SECURITY
# ============================================
JWT_SECRET=your-secret-key-dev-only
SESSION_SECRET=your-session-secret-dev-only

# Google OAuth (Sign in with Google)
# Create at: https://console.cloud.google.com/apis/credentials → OAuth 2.0 Client IDs
# Add http://localhost:5000/api/v1/auth/google/callback to Authorized redirect URIs.
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# ============================================
# AI SERVICES
# ============================================
OPENAI_API_KEY=sk-proj-...
IDEOGRAM_API_KEY=...
GOOGLE_API_KEY=

# ============================================
# PAYMENT - RAZORPAY (TEST MODE ONLY)
# ============================================
# From Dashboard with Test Mode ON: Settings → API Keys
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...
RAZORPAY_WEBHOOK_SECRET=test_infographic_hook_secret
# Plan IDs — Razorpay TEST mode. Dashboard naming: BG-<TIER>-<INTERVAL>-<YYYY>-<MM>
# These are the 2026-08 generation, created 2026-08-27 and verified against PLAN_CONFIG
# (shared/schema.ts) with: node scripts/verify-razorpay-plan-prices.mjs <env-file>
#
# The dashboard's amount field takes RUPEES; the API reports PAISE. An earlier set of
# BG-*-2026-08 plans was created at 100x by typing paise into it, and Razorpay Plans can
# be neither edited nor deleted — so identically-named 100x objects also exist in the
# dashboard. Always verify with the script above rather than copying by name.
#
# SOLO — Rs 5,499/mo, Rs 52,999/yr (app picks by billingPeriod; default vars optional)
RAZORPAY_PLAN_SOLO_MONTHLY=plan_TUnk0unqkkTA6n
RAZORPAY_PLAN_SOLO_ANNUAL=plan_TUnkphaNt7fy8y
# Optional fallback when _MONTHLY not set: set to Monthly plan ID
# RAZORPAY_PLAN_SOLO=plan_...
# PRO — Rs 10,999/mo, Rs 1,05,999/yr
RAZORPAY_PLAN_PRO_MONTHLY=plan_TUnlnHnvf8Up1k
RAZORPAY_PLAN_PRO_ANNUAL=plan_TUnmpHenwVPXAs
# TEAM — Rs 21,999/mo, Rs 2,10,999/yr
RAZORPAY_PLAN_TEAM_MONTHLY=plan_TUnnmrlVAvR6Dv
RAZORPAY_PLAN_TEAM_ANNUAL=plan_TUnoWAkCmYESuS
# RAZORPAY_PLAN_TEAM=plan_...
# AGENCY — Rs 43,999/mo, Rs 4,21,999/yr
RAZORPAY_PLAN_AGENCY_MONTHLY=plan_TUnpLHPMOrWOuE
RAZORPAY_PLAN_AGENCY_ANNUAL=plan_TUnqBkcNeLMRrM
# BROKERAGE: Monthly & Annual plans (optional)
RAZORPAY_PLAN_BROKERAGE_MONTHLY=plan_...
RAZORPAY_PLAN_BROKERAGE_ANNUAL=plan_...
# RAZORPAY_PLAN_BROKERAGE=plan_...
# API tiers (if used)
RAZORPAY_PLAN_API_STARTER=plan_...
RAZORPAY_PLAN_API_GROWTH=plan_...

# ============================================
# PAYMENT - STRIPE (TEST MODE - OPTIONAL)
# ============================================
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PLAN_SOLO=price_...
STRIPE_PLAN_TEAM=price_...
STRIPE_PLAN_BROKERAGE=price_...
STRIPE_PLAN_API_STARTER=price_...
STRIPE_PLAN_API_GROWTH=price_...

# ============================================
# FRONTEND (VITE) - Development
# ============================================
# Vite loads these when mode=development (npm run dev)
VITE_API_URL=http://localhost:3001
VITE_API_BASE=/api/v1
VITE_CLIENT_URL=http://localhost:5173
VITE_RAZORPAY_KEY_ID=rzp_test_...
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
VITE_ENABLE_STRIPE=false
VITE_ENABLE_ANALYTICS=false
# localStorage key prefix — change to final product code when name is confirmed (e.g. infographai)
VITE_STORAGE_PREFIX=buildographic
