{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Edit|Write|Apply)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CODEX_PROJECT_DIR}/.orion/hooks/pre-edit-env-secret.sh"
          }
        ]
      },
      {
        "matcher": "^(Edit|Write|Apply)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CODEX_PROJECT_DIR}/.orion/hooks/pre-edit-schema-warn.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Edit|Write|Apply)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CODEX_PROJECT_DIR}/.orion/hooks/post-edit-tasks-sync.sh"
          }
        ]
      },
      {
        "matcher": "^(Edit|Write|Apply)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CODEX_PROJECT_DIR}/.orion/hooks/post-edit-story-close-check.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CODEX_PROJECT_DIR}/.orion/hooks/stop-session-summary.sh"
          }
        ]
      }
    ]
  }
}